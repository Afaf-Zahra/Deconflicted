# Build the UI once, then serve the static files. Nothing is fetched at run time.
FROM node:22-slim AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web ./
ARG VITE_API=live
ARG VITE_API_BASE=http://localhost:8000
ENV VITE_API=$VITE_API VITE_API_BASE=$VITE_API_BASE
RUN npm run build

FROM python:3.11-slim
WORKDIR /srv
COPY --from=build /web/dist ./
EXPOSE 8080
CMD ["python", "-m", "http.server", "8080", "--bind", "0.0.0.0"]
