# One image runs the API, the three ledger nodes and the replay tool. Only the command differs.
FROM python:3.11-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 DECONFLICTED_CONFIG_DIR=/app/config
COPY requirements.txt requirements-ml.txt ./
# Two separate installs: requirements-ml.txt points pip at the PyTorch CPU index.
# Build with --build-arg WITH_ML=0 to leave the scorer's PyTorch out (the rest still runs).
ARG WITH_ML=1
RUN pip install --no-cache-dir -r requirements.txt
RUN if [ "$WITH_ML" = "1" ]; then pip install --no-cache-dir -r requirements-ml.txt; fi
COPY deconflicted ./deconflicted
COPY config ./config
COPY data ./data
EXPOSE 8000 9100
CMD ["uvicorn", "deconflicted.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
